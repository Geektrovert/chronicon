{
  "name": "chronicon",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "build": "bun run lint && bun run --cwd packages/cli build && next build",
    "start": "next start",
    "lint": "next typegen && oxlint --max-warnings 0",
    "doctor": "bunx vercel-doctor . --offline --yes --verbose",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "prepare": "effect-tsgo patch --oxlint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:migrate": "bun --env-file=.env.local scripts/migrate.ts",
    "owner:create": "bun --env-file=.env.local scripts/create-owner.ts",
    "storage:upload": "bun --env-file=.env.local scripts/upload-local-blobs.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@better-auth/api-key": "1.7.3",
    "@effect/platform-bun": "4.0.0-rc.112",
    "@effect/sql-pg": "4.0.0-rc.112",
    "@modelcontextprotocol/server": "2.0.0",
    "@tanstack/react-form": "^1.33.5",
    "@vercel/blob": "^2.8.0",
    "better-auth": "1.7.3",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.2.5",
    "effect": "4.0.0-rc.112",
    "htmlparser2": "^12.0.0",
    "lucide-react": "^1.41.0",
    "minisearch": "^7.2.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "sugar-high": "^2.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@effect/tsgo": "0.41.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "oxfmt": "^0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "portless": "0.15.6",
    "tailwindcss": "^4",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.4.2"
}
