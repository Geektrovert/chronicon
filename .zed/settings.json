{
  "format_on_save": "on",
  "prettier": {
    "allowed": false
  },
  "formatter": {
    "language_server": {
      "name": "oxfmt"
    }
  },
  "languages": {
    "TypeScript": {
      "language_servers": [
        "effect-tsgo",
        "oxlint",
        "oxfmt",
        "!typescript-ls",
        "!tsgo",
        "!vtsls",
        "!typescript-language-server",
        "!eslint",
        "..."
      ],
      "formatter": [
        {
          "code_action": "source.fixAll.oxc"
        },
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ]
    },
    "TSX": {
      "language_servers": [
        "effect-tsgo",
        "oxlint",
        "oxfmt",
        "!typescript-ls",
        "!tsgo",
        "!vtsls",
        "!typescript-language-server",
        "!eslint",
        "..."
      ],
      "formatter": [
        {
          "code_action": "source.fixAll.oxc"
        },
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ]
    },
    "JavaScript": {
      "language_servers": [
        "effect-tsgo",
        "oxlint",
        "oxfmt",
        "!typescript-ls",
        "!tsgo",
        "!vtsls",
        "!typescript-language-server",
        "!eslint",
        "..."
      ],
      "formatter": [
        {
          "code_action": "source.fixAll.oxc"
        },
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ]
    },
    "JSX": {
      "language_servers": [
        "effect-tsgo",
        "oxlint",
        "oxfmt",
        "!typescript-ls",
        "!tsgo",
        "!vtsls",
        "!typescript-language-server",
        "!eslint",
        "..."
      ],
      "formatter": [
        {
          "code_action": "source.fixAll.oxc"
        },
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ]
    }
  },
  "lsp": {
    "effect-tsgo": {
      "binary": {
        "path": "bun",
        "arguments": ["./node_modules/typescript/bin/tsc", "--lsp", "--stdio"]
      }
    },
    "oxlint": {
      "binary": {
        "path": "bun",
        "arguments": ["./node_modules/oxlint/bin/oxlint", "--lsp"]
      },
      "initialization_options": {
        "settings": {
          "run": "onType",
          "fixKind": "safe_fix"
        }
      }
    },
    "oxfmt": {
      "binary": {
        "path": "bun",
        "arguments": ["./node_modules/oxfmt/bin/oxfmt", "--lsp"]
      }
    }
  }
}
