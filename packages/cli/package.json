{
  "name": "@chronicon/cli",
  "version": "0.1.0",
  "description": "Publish and manage private Chronicon documents from your terminal.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Geektrovert/chronicon.git",
    "directory": "packages/cli"
  },
  "bin": {
    "chronicon": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build src/cli.ts --target=node --packages=external --outdir=dist",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "effect": "4.0.0-rc.112"
  },
  "engines": {
    "node": ">=22"
  }
}
