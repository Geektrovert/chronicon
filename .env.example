# Portless supplies the local origin automatically. Set the canonical HTTPS origin in production.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
# Optional selector for local owner/bootstrap and blob-migration commands only.
OWNER_EMAIL=
# Required in both local development and production.
DATABASE_URL=
# Required in production. Local development uses .chronicon/blobs when empty.
BLOB_READ_WRITE_TOKEN=
# Required for email verification and team/document invitations. Use a verified Resend sender.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Chronicon <hello@example.com>

# Existing US PostHog project 555830, shared with other apps. Events use app=chronicon.
# This phc_ project token is public and supports analytics, errors, OTLP logs and traces.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.posthog.com
POSTHOG_PROJECT_ID=555830
# Defaults to enabled for production builds with a project token. Set true for local inspection.
# NEXT_PUBLIC_POSTHOG_ENABLED=true
# Optional explicit release/environment. Vercel commit SHA and deployment environment are used otherwise.
# NEXT_PUBLIC_APP_RELEASE=
# NEXT_PUBLIC_APP_ENV=
# Optional server-side source-map upload key with error tracking write access.
# Never prefix this variable with NEXT_PUBLIC_. Source maps stay disabled until it is supplied.
POSTHOG_API_KEY=
# Native Effect OTLP drains default to PostHog using the public project token.
# POSTHOG_LOGS_ENABLED=true
# Controls both Effect and native Next.js server trace exports.
# POSTHOG_TRACES_ENABLED=true
# Disable all server OTLP exports; stdout logs and browser telemetry remain enabled.
# OTEL_SDK_DISABLED=true
# Optional independent OTLP HTTP/JSON destinations, including the final /v1/logs or /v1/traces path.
# The logs endpoint adds a second sink; the traces endpoint replaces the default destination.
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
# OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer%20YOUR_TOKEN
# OTEL_EXPORTER_OTLP_LOGS_HEADERS=
# OTEL_EXPORTER_OTLP_TRACES_HEADERS=
